<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:id="@+id/veltrix_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mc_version_spinner">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BRANDING -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VELTRIX"
                android:textColor="#B388FF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:gravity="center_vertical"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="24dp"
                android:text="MINECRAFT JAVA EDITION"
                android:textColor="#A3A3B8"
                android:textSize="11sp"
                android:letterSpacing="0.16"/>

            <!-- QUICK ACCESS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp">

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/news_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mcl_tab_wiki"
                    android:drawableStart="@drawable/ic_menu_news"/>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp"/>

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/discord_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mcl_button_discord"
                    android:drawableStart="@drawable/ic_discord"/>

            </LinearLayout>

            <!-- LAUNCHER TOOLS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOOLS"
                android:textColor="#B388FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mcl_option_customcontrol"
                android:drawableStart="@drawable/ic_menu_custom_controls"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_install_jar_file"
                android:drawableStart="@drawable/ic_menu_install_jar"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_share_log"
                android:drawableStart="@drawable/ic_menu_news"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_open_game_dir"
                android:drawableStart="@drawable/ic_menu_install_jar"/>

            <!-- VERSION SECTION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="READY TO PLAY?"
                android:textColor="#B388FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

        </LinearLayout>

    </ScrollView>

    <!-- EXISTING VERSION SELECTOR -->

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/veltrix_play_panel"/>

    <!-- PLAY PANEL -->

    <LinearLayout
        android:id="@+id/veltrix_play_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/background_app"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶  LAUNCH MINECRAFT"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7C4DFF"
            android:elevation="4dp"/>

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:contentDescription="Edit Minecraft profile"
            android:src="@drawable/ic_menu_news"
            android:backgroundTint="#29233A"
            android:tint="#B388FF"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
